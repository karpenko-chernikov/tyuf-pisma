[Unit]
Description=ТЮФ письма (FastAPI)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/tyuf-pisma
EnvironmentFile=/var/www/tyuf-pisma/.env
Environment=HOST=127.0.0.1
Environment=PORT=8010
ExecStart=/var/www/tyuf-pisma/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
